# OpenAI-compatible language model endpoint used for Spot Chat and text-query parsing.
HISTAGENT_API_BASE_URL=http://127.0.0.1:8001/v1
HISTAGENT_MODEL=Qwen3-8B-local
HISTAGENT_API_KEY=local-empty-key

# HistAgent image inference. Prov-GigaPath requires an authenticated HF session.
HISTAGENT_CHECKPOINT=wli13/HistAgent
HISTAGENT_BASE_CHECKPOINT=
HF_TOKEN=

# Web server.
HOST=127.0.0.1
PORT=7860
